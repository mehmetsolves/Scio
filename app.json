{
  "expo": {
    "name": "Scio",
    "slug": "scio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FAF7F2"
    },
    "android": {
      "package": "com.scio.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF7F2"
      },
      "permissions": ["INTERNET"]
    },
    "ios": {
      "bundleIdentifier": "com.scio.app",
      "supportsTablet": true
    },
    "plugins": [
      "expo-asset",
      "expo-secure-store",
      "./plugins/adi-registration"
    ],
    "extra": {
      "eas": {
        "projectId": "46886382-dd2a-4a8f-9342-ff0477f96333"
      }
    }
  }
}
