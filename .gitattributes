# Depoda satır sonları her zaman LF kalsın (Windows'ta CRLF kaosunu önler)
* text=auto eol=lf

# İkili dosyalar — git bunlara dokunmasın
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.apk binary
*.aab binary
*.ipa binary

# Paket kilidi dosyaları diff'te gürültü yapmasın
package-lock.json -diff linguist-generated=true
